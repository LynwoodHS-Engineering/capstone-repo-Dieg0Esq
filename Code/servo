Servo Wire	    Uno Pin
Black	            GND
Yellow	          5V
White            	A2



#include <Servo.h>

Servo turret;

const int servoPin = A2;

void setup() {
  turret.attach(servoPin);

  // center position
  turret.write(90);

  delay(1000);
}

void loop() {

  // UP
  turret.write(150);
  delay(1000);

  // CENTER
  turret.write(90);
  delay(1000);

  // DOWN
  turret.write(30);
  delay(1000);

  // CENTER again
  turret.write(90);
  delay(1000);
}
